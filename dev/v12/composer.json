{
	"name": "klimadashboard/typo3-klimadashboard-dev-v12",
	"description": "Local TYPO3 12 test environment for the Klimadashboard extension (DDEV)",
	"type": "project",
	"license": "GPL-2.0-or-later",
	"repositories": [
		{
			"type": "path",
			"url": "../../",
			"options": {
				"symlink": true
			}
		},
		{
			"type": "path",
			"url": "../packages/*",
			"options": {
				"symlink": true
			}
		}
	],
	"require": {
		"klimadashboard/demo-site": "@dev",
		"klimadashboard/typo3-klimadashboard": "@dev",
		"typo3/cms-backend": "^12.4",
		"typo3/cms-belog": "^12.4",
		"typo3/cms-core": "^12.4",
		"typo3/cms-extbase": "^12.4",
		"typo3/cms-extensionmanager": "^12.4",
		"typo3/cms-fluid": "^12.4",
		"typo3/cms-fluid-styled-content": "^12.4",
		"typo3/cms-frontend": "^12.4",
		"typo3/cms-install": "^12.4",
		"typo3/cms-lowlevel": "^12.4",
		"typo3/cms-setup": "^12.4",
		"typo3/cms-tstemplate": "^12.4"
	},
	"minimum-stability": "stable",
	"prefer-stable": true,
	"config": {
		"allow-plugins": {
			"typo3/class-alias-loader": true,
			"typo3/cms-composer-installers": true
		},
		"sort-packages": true,
		"policy": {
			"advisories": {
				"block": false
			}
		}
	},
	"extra": {
		"comment": "Local test environment only: public TYPO3 12.4 releases after the end of regular support may have advisories fixed only in ELTS, so Composer's advisory block is disabled here. Never deploy this project."
	}
}
