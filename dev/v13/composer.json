{
	"name": "klimadashboard/typo3-klimadashboard-dev-v13",
	"description": "Local TYPO3 13 test environment for the Klimadashboard extension (DDEV)",
	"type": "project",
	"license": "GPL-2.0-or-later",
	"repositories": [
		{
			"type": "path",
			"url": "../../",
			"options": {
				"symlink": true
			}
		},
		{
			"type": "path",
			"url": "../packages/*",
			"options": {
				"symlink": true
			}
		}
	],
	"require": {
		"klimadashboard/typo3-klimadashboard": "@dev",
		"klimadashboard/demo-site": "@dev",
		"typo3/cms-backend": "^13.4",
		"typo3/cms-belog": "^13.4",
		"typo3/cms-core": "^13.4",
		"typo3/cms-extbase": "^13.4",
		"typo3/cms-fluid": "^13.4",
		"typo3/cms-fluid-styled-content": "^13.4",
		"typo3/cms-frontend": "^13.4",
		"typo3/cms-install": "^13.4",
		"typo3/cms-lowlevel": "^13.4",
		"typo3/cms-setup": "^13.4",
		"typo3/cms-tstemplate": "^13.4"
	},
	"minimum-stability": "stable",
	"prefer-stable": true,
	"config": {
		"allow-plugins": {
			"typo3/class-alias-loader": true,
			"typo3/cms-composer-installers": true
		},
		"sort-packages": true
	}
}
